    "“%@” stops and its saved history, with its subagent chats, moves to the Trash on your Mac. To get it back, put the folder back and restart DSH.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” stops and its saved history, with its subagent chats, moves to the Trash on your Mac. To get it back, put the folder back and restart DSH."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” sohbeti durur. Kayıtlı geçmişi, alt ajan sohbetleriyle birlikte Mac’inizdeki Çöp Sepeti’ne taşınır. Sohbeti geri almak için klasörü Çöp Sepeti’nden geri koyun ve DSH’yi yeniden başlatın."
          }
        }
      }
    },

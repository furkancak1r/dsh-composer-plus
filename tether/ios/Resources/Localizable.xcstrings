    "Can't reach %@ at %@. Put this iPhone on the same Wi‑Fi as the Mac. If iOS asks to find devices on your local network, tap Allow.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach %1$@ at %2$@. Put this iPhone on the same Wi‑Fi as the Mac. If iOS asks to find devices on your local network, tap Allow."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ adlı Mac’e %2$@ adresinden ulaşılamıyor. Bu iPhone’u Mac ile aynı Wi‑Fi ağına bağlayın. iOS yerel ağdaki cihazları bulmak için izin isterse izin verin."
          }
        }
      }
    },
    "Can't reach the Mac. Is DSH open and Tailscale or Wi-Fi on?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach the Mac. Is DSH open and Tailscale or Wi-Fi on?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’e ulaşılamıyor. DSH açık mı, Tailscale ya da Wi-Fi açık mı?"
          }
        }
      }
    },
    "Can't reach your Mac. Make sure it's awake and on the same Wi‑Fi.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach your Mac. Make sure it's awake and on the same Wi‑Fi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’inize ulaşılamıyor. Mac’in uyku modunda olmadığından ve aynı Wi‑Fi ağına bağlı olduğundan emin olun."
          }
        }
      }
    },
    "Can't reach your Mac. On the same Wi‑Fi, check it's awake; elsewhere, open Tailscale on both.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach your Mac. On the same Wi‑Fi, check it's awake; elsewhere, open Tailscale on both."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’inize ulaşılamıyor. Aynı Wi‑Fi ağındaysanız Mac’in uyku modunda olmadığını kontrol edin; başka bir yerdeyseniz iki cihazda da Tailscale’i açın."
          }
        }

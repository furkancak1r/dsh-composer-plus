    "A copy of this chat answers in read-only mode. This chat goes on working. In the side chat, Bring back puts the answer into this chat's message field.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A copy of this chat answers in read-only mode. This chat goes on working. In the side chat, Bring back puts the answer into this chat's message field."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sohbetin bir kopyası soruyu salt okunur modda yanıtlar. Bu sohbet çalışmaya devam eder. Yan sohbette “Geri getir” düğmesi yanıtı bu sohbetin yazma alanına koyar."
          }
        }
      }
    },

{
  "name": "dsh-composer-plus",
  "version": "1.5.0",
  "description": "DeepSeek Harness helpers: 11 extra UI languages (Türkçe, Español, Français, Deutsch, 日本語…), Changes panel, input history, Shift+Tab /plan, one-click Continue, queue drag-and-drop, deeplinks, Auto Review allow-for-chat, notifications, iPhone access with the Tether app, automatic updates",
  "icon": "./assets/icon.svg",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "auto-review",
    "auto-update",
    "changes",
    "claude-code",
    "codex",
    "collapse-all",
    "composer-plus",
    "continue",
    "copy-path",
    "deeplink",
    "deepseek",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "drag-and-drop",
    "dsh",
    "dsh-composer-plus",
    "dsh-plugin",
    "dsh-plugins",
    "git",
    "git-diff",
    "i18n",
    "input-history",
    "ios",
    "iphone",
    "localization",
    "mobile",
    "notifications",
    "plan-mode",
    "plugin",
    "queue",
    "recent-projects",
    "remote-control",
    "sort-by-status",
    "tailscale",
    "tether",
    "translation"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "tether/gateway/server.mjs",
    "tether/gateway/admin.html",
    "tether/gateway/qr.swift",
    "locale/*.json",
    "assets/icon.svg",
    "cordis.patch.yml",
    "/README.md",
    "LICENSE",
    "locales/LICENSE",
    "assets/features/*.webp"
  ],
  "scripts": {
    "test": "node scripts/build-locales.mjs --check && node test/locale.test.mjs && node test/continue.test.mjs && node test/continue-host.test.mjs && node test/queue-drag.test.mjs && node test/plan-toggle.test.mjs && node test/keep-focus.test.mjs && node test/mobile-connect.test.mjs && node test/tether-gateway.test.mjs && node test/deeplink.test.mjs && node test/chat-grant.test.mjs && node test/notify.test.mjs && node test/changes.test.mjs && node test/project-status.test.mjs && node test/recent-projects.test.mjs && node test/project-tools.test.mjs && node test/status-order.test.mjs && node test/toggles.test.mjs && node test/update.test.mjs && node test/meta.test.mjs && node test/shots.test.mjs",
    "build:locales": "node scripts/build-locales.mjs",
    "prepublishOnly": "npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/furkancak1r/dsh-composer-plus.git"
  },
  "homepage": "https://github.com/furkancak1r/dsh-composer-plus#readme",
  "bugs": {
    "url": "https://github.com/furkancak1r/dsh-composer-plus/issues"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
